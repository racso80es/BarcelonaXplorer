# ============================================================
# BarcelonaXplorer — Variables de Entorno
# ============================================================
# Copia este archivo como .env.local y rellena los valores reales.
#   cp .env.example .env.local
# ============================================================

# === Base de Datos ===
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=barcelonaxplorer_db
MYSQL_USER=bx_admin
MYSQL_PASSWORD=your_password
DATABASE_URL=mysql://bx_admin:your_password@127.0.0.1:3306/barcelonaxplorer_db

# === Orquestador Principal (Gemini) ===
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODELS="gemini-1.5-flash,gemini-1.5-pro,gemini-1.0-pro"

# === Motor Rápido — Radar BX (Groq) ===
GROQ_API_KEY="gsk_your_groq_api_key"
GROQ_FAST_MODEL="qwen/qwen3.8-27b"
GROQ_RADAR_MAX_TOKENS=100
GROQ_RADAR_SYSTEM_PROMPT="Eres el Radar de BarcelonaXplorer. Responde con un único micro-consejo directo de 1 frase. Prioriza logística local o el Escudo Anti-Trampas (evita recomendar zonas turísticas masificadas o caras). Cero saludos. Cero despedidas."

# === Panel de Administración (/Admin) ===
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9 # SHA-256 de 'admin123'

