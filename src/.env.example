# ============================================================
# BarcelonaXplorer — Variables de Entorno
# ============================================================
# Copia este archivo como .env.local y rellena los valores reales.
#   cp .env.example .env.local
# ============================================================

# === Base de Datos ===
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=barcelonaxplorer_db
MYSQL_USER=bx_admin
MYSQL_PASSWORD=your_password
DATABASE_URL=mysql://bx_admin:your_password@127.0.0.1:3306/barcelonaxplorer_db

# === Orquestador Principal (Gemini) ===
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODELS="gemini-1.5-flash,gemini-1.5-pro,gemini-1.0-pro"

# === Motor Rápido — Radar BX (Groq) ===
GROQ_API_KEY="gsk_your_groq_api_key"
GROQ_FAST_MODEL="qwen/qwen3.8-27b"
GROQ_RADAR_MAX_TOKENS=100
GROQ_RADAR_SYSTEM_PROMPT="Eres el Radar de BarcelonaXplorer. Responde con un único micro-consejo directo de 1 frase. Prioriza logística local o el Escudo Anti-Trampas (evita recomendar zonas turísticas masificadas o caras). Cero saludos. Cero despedidas."

# === Panel de Administración (/Admin) ===
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9 # SHA-256 de 'admin123'

# === Órgano Sensorial y Telemetría Centralizada ===
TELEMETRY_LLM_ENABLED=false # true para auditar inferencias IA, false para reposo térmico
CRON_SECRET=your_secret_cron_token_for_pruning # Token para /api/telemetry/prune

# === Motor de Decisión Determinista (Jev AI - System One) ===
JEV_API_KEY="sk_jev_your_api_key"
JEV_BASE_URL="https://jev-ai.pro/api"
JEV_HEALTH_TIMEOUT_MS=2000
JEV_LATENCY_WARN_THRESHOLD_MS=800
JEV_MODEL="jev-latest"

# === Anclaje Táctico (Telegram Bridge & Magic Links) ===
ANCHOR_AES_KEY="your_32_bytes_or_string_key_for_aes_gcm" # Clave de 256 bits para cifrado opaco del deep link
TELEGRAM_BOT_TOKEN="your_telegram_bot_token" # Token proporcionado por @BotFather
TELEGRAM_BOT_USERNAME="BXplorerBot" # Username público del bot
TELEGRAM_WEBHOOK_SECRET="your_random_secure_telegram_webhook_secret_32_chars" # Header X-Telegram-Bot-Api-Secret-Token
MAGIC_LINK_SECRET="your_secret_key_for_magic_link_hmac_sha256" # Firma de enlaces mágicos temporales
NEXT_PUBLIC_APP_URL="https://barcelonaxplorer.com" # URL base para links y deep links

