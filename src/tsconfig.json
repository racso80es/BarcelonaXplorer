{
  // ═══════════════════════════════════════════════════════════════
  // Configuración del Compilador TypeScript — BarcelonaXplorer
  // Marco Constitucional: Protocolo de Acero — Grado S+
  // Axioma II: Tolerancia Cero a la Inferencia (strict: true)
  // Axioma V: Transparencia Estructural (isolatedModules: true)
  // ═══════════════════════════════════════════════════════════════
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    // Axioma II: Cero inferencia de tipos — Tipado estricto absoluto
    "strict": true,
    // Axioma III: Verificación de tipos pura sin emisión de artefactos (delegado a Next.js)
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // Axioma II: Importación estructurada y tipada de archivos de datos JSON
    "resolveJsonModule": true,
    // Axioma V: Transparencia y autonomía — Cada módulo transpila independientemente
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // Axioma I: Localidad de comportamiento — Alias canónico para resolución interna
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}

