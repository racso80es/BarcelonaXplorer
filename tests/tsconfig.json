{
  "extends": "../src/tsconfig.json",
  "compilerOptions": {
    "rootDirs": ["../src", "."],
    "paths": {
      "@/*": ["../src/*"],
      "@/features/*": ["../src/features/*"],
      "@/shared/*": ["../src/shared/*"],
      "vitest": ["../src/node_modules/vitest"],
      "vitest/*": ["../src/node_modules/vitest/*"],
      "next/*": ["../src/node_modules/next/*"],
      "@prisma/client": ["../src/node_modules/@prisma/client"],
      "zod": ["../src/node_modules/zod"],
      "@testing-library/react": ["../src/node_modules/@testing-library/react"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
